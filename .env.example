# Copy this file to .env and adjust values as needed.
# Never commit .env to version control.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./fraud_detection.db

# ML Paths (relative to project root)
DATA_RAW_PATH=data/raw/creditcard.csv
MODEL_DIR=backend/models
REPORTS_DIR=backend/reports

# Simulation defaults
DEFAULT_SIM_INTERVAL_SECONDS=1.0
DEFAULT_SIM_BATCH_SIZE=1

# Risk thresholds (fraud probability 0.0–1.0)
RISK_LOW_THRESHOLD=0.30
RISK_HIGH_THRESHOLD=0.70

# Random seed for reproducibility
RANDOM_SEED=42

# Training
MAX_CONCURRENT_TRAINING_JOBS=1
